# MariaDB (used by docker-compose to create the database and by the backend to connect)
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=dissidia-arena
MARIADB_USER=change-me
MARIADB_PASSWORD=change-me
# Optional: if set it overrides the MARIADB_* values above, so keep the two in sync.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/dissidia-arena?charset=utf8mb4

# Flask session signing key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Discord OAuth2: https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must be added verbatim under OAuth2 -> Redirects on the Discord application.
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback
FRONTEND_URL=http://localhost:5173
# Set to true in production (HTTPS only cookies)
SESSION_COOKIE_SECURE=false
