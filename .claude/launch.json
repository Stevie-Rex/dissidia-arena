{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && FLASK_APP=run.py .venv/bin/flask run --host 127.0.0.1 --port 5000"],
      "port": 5000
    },
    {
      "name": "web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend && npm run dev -- --port 5173 --strictPort"],
      "port": 5173
    }
  ]
}
